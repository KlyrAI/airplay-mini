<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Spotify Connect receiver. Runs as the audio user so it plays through that
     session's default output, which node-agent.sh keeps pinned to the DAC.
     Installed by bootstrap.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@SPOTIFYD@</string>
    <string>--no-daemon</string>
    <string>--config-path</string>
    <string>@CONF@</string>
  </array>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>@AUDIO_HOME@/Library/Logs/spotifyd.log</string>
  <key>StandardErrorPath</key>
  <string>@AUDIO_HOME@/Library/Logs/spotifyd.log</string>
</dict>
</plist>
