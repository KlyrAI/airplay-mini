# airplay-mini site config.
# Copy to config.env (gitignored: it holds a password and the Tailscale key),
# fill it in, then run ./bootstrap.sh. Safe to edit and re-run any time.

# Name shown in the AirPlay and Spotify pickers. Also becomes the computer
# name. Letters, digits, spaces, and . _ - ' only.
DEVICE_NAME="Lobby Audio"

# Standard (non-admin) account that logs in automatically at boot and owns
# the audio session. Created if missing. The password is needed for auto-login.
AUDIO_USER="audio"
AUDIO_USER_FULLNAME="Audio"
AUDIO_USER_PASSWORD=""

# Part of the output device's name, matched case-sensitively. To list devices:
#   SwitchAudioSource -a -t output
# A USB-C DAC cable usually shows as something like "USB Audio Device".
# Without a DAC, use the Mac mini's 3.5 mm jack: "External Headphones".
OUTPUT_MATCH="USB"

# Output volume (0-100), set once each time the audio user logs in. After that
# the AirPlay sender's volume slider controls it. Set the level on the preamp.
LOGIN_VOLUME="70"

# Who may AirPlay to this Mac: same-network | current-user
# "everyone" is refused: it lets any nearby iPhone connect over peer-to-peer
# Wi-Fi without joining the client's network.
AIRPLAY_ACCESS="same-network"

# Tailscale remote access. Use a pre-approved, tagged auth key
# (tag:audio-node). If this is empty, bootstrap skips the login and prints the
# command to run by hand.
TAILSCALE_AUTHKEY=""
# Leave empty to derive it from DEVICE_NAME (e.g. "lobby-audio").
TAILSCALE_HOSTNAME=""

# Spotify Connect via spotifyd. Senders need Spotify Premium.
SPOTIFY_ENABLED="true"
# 96 | 160 | 320
SPOTIFY_BITRATE="320"

# Optional heartbeat URL, e.g. https://hc-ping.com/<uuid> from healthchecks.io.
# Pinged every 5 minutes while healthy, and at <url>/fail when something
# breaks. Leave empty to turn it off.
HEALTHCHECK_URL=""

# Optional weekly reboot: "<Sun|Mon|Tue|Wed|Thu|Fri|Sat> <HH:MM>" (24h, local
# time). Leave empty to turn it off.
WEEKLY_REBOOT="Mon 05:00"
