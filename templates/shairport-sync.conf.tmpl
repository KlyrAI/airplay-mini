// Shairport Sync config, written by bootstrap.sh from config.env. Edits here
// are overwritten on the next bootstrap run.
// Reference: the sample at github.com/mikebrady/shairport-sync scripts/shairport-sync.conf

general = {
  name = "@DEVICE_NAME@";
  // CoreAudio plays to the session's default output, which node-agent.sh
  // keeps on the DAC. dns-sd advertises through macOS's own mDNSResponder.
  output_backend = "coreaudio";
  mdns_backend = "dns-sd";
  // "yes": the sender's volume slider does nothing; the preamp sets the level.
  ignore_volume_control = "@IGNORE_VOLUME@";
};

sessioncontrol = {
  // Free the speaker 20 s after a sender disappears (default 60).
  session_timeout = 20;
};

diagnostics = {
  log_verbosity = 0;
};
